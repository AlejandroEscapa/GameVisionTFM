<?xml version="1.0" encoding="utf-8"?><!--
   Reglas de backup automático para dispositivos con API &lt; 31 (configuración
   muerta con minSdk 33, se mantiene por si baja el minSdk).
   Nota: en full-backup-content el dominio "database" no admite subdirectorios;
   la caché de Firestore se excluye vía data_extraction_rules.xml en API 31+.
-->
<full-backup-content>
    <exclude domain="file" path="datastore/" />
    <exclude domain="file" path="firestore/" />
</full-backup-content>
