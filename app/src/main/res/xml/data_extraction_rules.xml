<?xml version="1.0" encoding="utf-8"?><!--
   Reglas de extracción de datos (backup en la nube y transferencia de dispositivo).
   Se excluyen los datos sensibles o reconstruibles: la caché de Firestore contiene
   datos del usuario; DataStore se recrea al primer arranque.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/" />
        <exclude domain="database" path="firestore/" />
        <exclude domain="file" path="firestore/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/" />
        <exclude domain="database" path="firestore/" />
        <exclude domain="file" path="firestore/" />
    </device-transfer>
</data-extraction-rules>
