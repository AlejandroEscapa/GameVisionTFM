<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".GameVisionApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/gamevisionnoletters"
        android:label="@string/app_name"
        android:roundIcon="@drawable/gamevisionnoletters"
        android:supportsRtl="true"
        android:theme="@style/Gamevision"
        tools:targetApi="31"
        android:enableOnBackInvokedCallback="true"
        tools:ignore="CredManMissingDal">
        <!-- CredManMissingDal: solo usamos Credential Manager para "Sign in with Google";
             no hay inicio de sesión por contraseña ni passkeys, así que el asset statements
             (assetlinks.json) que exige la regla no aplica. Revisar si se añaden passkeys. -->

        <!-- Meta data para Google Sign-In -->
        <meta-data
            android:name="com.google.android.gms.auth.api.signin.API_KEY"
            android:value="@string/default_web_client_id" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Gamevision"
            android:windowSoftInputMode="adjustResize">            <!-- Retorno del OpenID de Steam vía proxy (bloque 5): esquema propio.
                 No necesita assetlinks porque no es un App Link verificado. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="gamevision" android:host="steam" android:path="/linked" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- FileProvider para compartir la imagen del Rewind (F3/T3.9).
             La imagen se escribe en la caché y se expone con un content:// URI: pasar
             un file:// a otra app lanza FileUriExposedException desde Android 7, y aquí
             el receptor es la app que el usuario elija en la hoja de compartir. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>