rules_version = '2';

// ============================================================================
// GameVision — reglas de Firestore (F0-B, 28/09/2026)
//
// - Datos nuevos por UID (Firebase Auth): users/{uid}/library|logs|sessions|stats
//   → solo su dueño puede leerlos y escribirlos.
// - Perfil (documento raíz): lectura para cualquier usuario autenticado
//   (necesario para añadir amigos por email); escritura, solo el dueño.
// - Rutas heredadas por email (amigos, mensajes): transitorias hasta B3/F2.
//   · friends: solo el dueño.
//   · messages: lectura para autenticados (los muros se ven entre usuarios);
//     escritura, solo el dueño del muro.
// - Todo lo demás, cerrado.
//
// Nota (F2): el muro y la lectura de perfiles se rediseñarán con colecciones
// públicas / Cloud Functions para no exponer datos de más (D2.4 del roadmap).
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ¿Es el dueño del documento (por uid o, transitoriamente, por email)?
    function isOwner(userId) {
      return request.auth != null
        && (request.auth.uid == userId || request.auth.token.email == userId);
    }

    match /users/{userId} {
      // Perfil raíz: escribir solo el dueño; leer, cualquier usuario autenticado.
      allow read: if request.auth != null;
      allow create, update, delete: if isOwner(userId);

      // Biblioteca (F0-B) — solo el dueño.
      match /library/{gameId}     { allow read, write: if isOwner(userId); }
      match /logs/{logId}         { allow read, write: if isOwner(userId); }
      match /sessions/{sessionId} { allow read, write: if isOwner(userId); }
      match /stats/{docId}        { allow read, write: if isOwner(userId); }

      // Rutas heredadas (transitorias hasta B3).
      match /friends/{friendId}   { allow read, write: if isOwner(userId); }
      match /messages/{messageId} {
        allow read: if request.auth != null;
        allow write: if isOwner(userId);
      }

      // Listas antiguas (playedlist/wishlist/favorites/history) y cualquier otra
      // subcolección no listada: cerradas; se borran en B3.
      match /{document=**} { allow read, write: if false; }
    }

    // El resto de la base queda cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
