rules_version = '2';

// ============================================================================
// GameVision — reglas de Firestore (ADR-0008, 29/09/2026)
//
// Clave ÚNICA de identidad: uid de Firebase Auth.
//   users/{uid}                          → perfil (el email es un CAMPO)
//   users/{uid}/library|logs|sessions|stats   → datos del usuario
//   users/{uid}/friends|messages              → social
//   profile_images/{uid}                 → foto de perfil (base64)
//   email_index/{email}                  → índice email → { uid } (resolver amigos)
//   usernames/{username}                 → índice username → { uid } (búsqueda, F2)
//
// Se elimina el parche anterior (uid == id || email == id): ahora SOLO uid.
// El email no aparece en ninguna ruta (privacidad por diseño; coherente con D2.4).
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Dueño del documento: el uid autenticado debe coincidir con el id.
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId} {
      // Perfil: escribir solo el dueño; leer, cualquier usuario autenticado.
      allow read: if request.auth != null;
      allow create, update, delete: if isOwner(userId);

      match /library/{gameId}     { allow read, write: if isOwner(userId); }
      match /logs/{logId}         { allow read, write: if isOwner(userId); }
      match /sessions/{sessionId} { allow read, write: if isOwner(userId); }
      match /stats/{docId}        { allow read, write: if isOwner(userId); }
      match /friends/{friendId}   { allow read, write: if isOwner(userId); }
      match /messages/{messageId} {
        allow read: if request.auth != null;
        allow write: if isOwner(userId);
      }

      // Cualquier otra subcolección no listada: cerrada.
      match /{document=**} { allow read, write: if false; }
    }

    // Foto de perfil (ADR-0007): el dueño escribe; cualquier autenticado lee.
    match /profile_images/{userId} {
      allow read: if request.auth != null;
      allow write, delete: if isOwner(userId);
    }

    // Índice email → uid: lectura autenticada; escritura solo del propio uid.
    //
    // IMPORTANTE: basta con exigir `request.resource.data.uid == request.auth.uid` para
    // la ESCRITURA, porque eso solo mira lo que se escribe. Un `update` de otra persona
    // pasaría igual y podría secuestrar la entrada (apuntar el email de otro a tu uid).
    // Por eso `update` exige TAMBIÉN que la entrada ya sea tuya.
    match /email_index/{email} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    // Índice username → uid. Igual que `email_index`: crear el propio, reescribir solo
    // si ya era tuyo (evita robar nombres de usuario ajenos), borrar solo el tuyo.
    match /usernames/{username} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    // El resto de la base queda cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
