rules_version = '2';

// Reglas de Firebase Storage (F0/T0.12 — fotos de perfil).
// Pendiente de publicar por el propietario: Firebase Console → Storage → Rules
// (o con firebase CLI al configurar el deploy). Mientras no se publiquen,
// el bucket usa las reglas por defecto y la subida puede fallar.
service firebase.storage {
  match /b/{bucket}/o {
    // Foto de perfil: cada usuario solo escribe en su carpeta (su email exacto,
    // que no contiene '/'). Lectura solo para autenticados (los avatares son
    // visibles en la capa social desde F2).
    match /profile_images/{email}/profile.jpg {
      allow read: if request.auth != null;
      allow write, delete: if request.auth != null && request.auth.token.email == email;
    }
  }
}
