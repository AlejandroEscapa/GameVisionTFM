rules_version = '2';

// ============================================================================
// ARCHIVADAS (ADR-0007) — NO se despliegan.
//
// Cloud Storage for Firebase exige el plan de pago Blaze incluso para una sola
// foto de perfil. Se sustituyó por la colección `profile_images/{uid}` de
// Firestore (ver firebase/firestore.rules y docs/metodologia/adr/0007-*.md).
// Este archivo queda como referencia por si algún día se suben imágenes que
// justifiquen un bucket real (muchas imágenes, vídeo o CDN).
// ============================================================================
service firebase.storage {
  match /b/{bucket}/o {
    match /profile_images/{email}/profile.jpg {
      allow read: if request.auth != null;
      allow write, delete: if request.auth != null && request.auth.token.email == email;
    }
  }
}
